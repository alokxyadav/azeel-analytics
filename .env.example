# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# Random secret that signs sessions. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Addresses --------------------------------------------------------------
# Local defaults shown. For production use your real https URLs, e.g.
#   SITE_URL=https://app.example.com   API_URL=https://api.example.com
SITE_URL=http://localhost:3000
API_URL=http://localhost:8000
# Public contact address shown on the site and in the legal pages
CONTACT_EMAIL=hello@azeel.tech

# --- Production deployment (docker-compose.prod.yml) -------------------------
# Domains Caddy obtains HTTPS certificates for (DNS must already point here)
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# Needed by Let's Encrypt for expiry notices
ACME_EMAIL=you@example.com

# --- Email (optional but recommended: password reset and contact notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false
MAIL_FROM=Azeel Analytics <no-reply@example.com>
# Where contact-form messages are forwarded (they are always stored in the database)
CONTACT_RECIPIENT=
# auto = require email verification before uploads only when SMTP_HOST is set. Use true/false to force.
REQUIRE_EMAIL_VERIFICATION=auto

# --- Scaling (docker-compose.prod.yml) ---------------------------------------
# Backend worker processes. More than 1 is safe because rate limits are shared through Redis.
WEB_CONCURRENCY=2
